      <rdf:li><foaf:Person><foaf:givenName>Ashish</foaf:givenName><foaf:surname>Sabharwal</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Journal><dc:title>Transactions of the Association for Computational Linguistics</dc:title></bib:Journal></dcterms:isPartOf>
    <bib:volume>10</bib:volume>
    <bib:pages>539–554</bib:pages>
