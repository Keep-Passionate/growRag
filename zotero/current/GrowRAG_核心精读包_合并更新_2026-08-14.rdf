      <rdf:li><foaf:Person><foaf:givenName>Graham</foaf:givenName><foaf:surname>Neubig</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 42nd International Conference on Machine Learning</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>63897–63911</bib:pages>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-工作流记忆</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-ICML</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#dynamiccheatsheet">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Dynamic Cheatsheet: Test-Time Learning with Adaptive Memory</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://aclanthology.org/2026.eacl-long.333/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2026.eacl-long.333</dc:identifier>
    <z:extra>发表状态：已同行评审，EACL 2026 Main Long 正式论文。阅读优先级：P0-经验笔记最近邻。为什么读：它让黑盒模型在测试时持续维护简洁策略、解题草图和代码片段，而非保存整段对话，直接反驳“压缩轨迹为可复用笔记无人研究”。精读问题：累计版与检索版怎样更新、删除和压缩？无需标签时凭什么判断经验有效？记忆增长、上下文成本和负迁移如何报告？哪些任务依赖代码片段而非一般策略？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Mirac</foaf:givenName><foaf:surname>Suzgun</foaf:surname></foaf:Person></rdf:li>
