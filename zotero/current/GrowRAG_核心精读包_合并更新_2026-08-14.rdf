    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 63rd Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>3551–3578</bib:pages>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-检索后修复</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-ACL-Main</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#hotpotqa">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>HotpotQA: A Dataset for Diverse, Explainable Multi-hop Question Answering</dc:title>
    <dc:date>2018</dc:date>
    <z:url>https://aclanthology.org/D18-1259/</z:url>
    <dc:identifier>DOI: 10.18653/v1/D18-1259</dc:identifier>
    <z:extra>发表状态：已同行评审，EMNLP 2018 Main 正式论文。阅读优先级：P0-首轮主数据集。为什么读：它同时提供答案和 supporting facts，适合把检索成功、证据充分和最终答案正确拆开评价，并检验桥接型与比较型问题上的经验迁移。精读问题：distractor 与 fullwiki 设置有何差异？supporting-fact 标注位于句子还是文档层？桥接题和比较题如何分布？官方 EM、F1 与 supporting-fact 指标怎样计算？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Zhilin</foaf:givenName><foaf:surname>Yang</foaf:surname></foaf:Person></rdf:li>
