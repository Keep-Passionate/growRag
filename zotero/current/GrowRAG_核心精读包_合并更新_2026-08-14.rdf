  </bib:Article>

  <!-- ==================== 轨迹压缩与经验笔记 ==================== -->

  <bib:Article rdf:about="#reflexion">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Reflexion: Language Agents with Verbal Reinforcement Learning</dc:title>
    <dc:date>2023</dc:date>
    <z:url>https://proceedings.neurips.cc/paper_files/paper/2023/hash/1b44b878bb782e6954cd888628510e90-Abstract-Conference.html</z:url>
    <dc:identifier>DOI: 10.52202/075280-0377</dc:identifier>
    <z:extra>发表状态：已同行评审，NeurIPS 2023 Main 正式论文。阅读优先级：P0-语言经验记忆起点。为什么读：它把环境反馈转成自然语言反思并保存在 episodic memory 中供后续重试，是失败到教训再到复用的经典原型。精读问题：反思主要服务同一任务重试还是跨任务迁移？反馈来自规则、模型还是外部环境？记忆窗口多长？怎样区分反思本身有效与额外采样预算有效？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Noah</foaf:givenName><foaf:surname>Shinn</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Federico</foaf:givenName><foaf:surname>Cassano</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Ashwin</foaf:givenName><foaf:surname>Gopinath</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Karthik</foaf:givenName><foaf:surname>Narasimhan</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Shunyu</foaf:givenName><foaf:surname>Yao</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Advances in Neural Information Processing Systems 36 (NeurIPS 2023)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-反思记忆</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-NeurIPS</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#expel">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>ExpeL: LLM Agents Are Experiential Learners</dc:title>
    <dc:date>2024</dc:date>
    <z:url>https://ojs.aaai.org/index.php/AAAI/article/view/29936</z:url>
    <dc:identifier>DOI: 10.1609/aaai.v38i17.29936</dc:identifier>
    <z:extra>发表状态：已同行评审，AAAI 2024 正式论文。阅读优先级：P0-经验抽取基线。为什么读：ExpeL 同时保存成功轨迹，并通过成功与失败对比抽取可跨任务复用的自然语言 insight；HotpotQA 实验使其与本项目直接相关。精读问题：ADD、UPVOTE、DOWNVOTE、EDIT 怎样维护 insight？轨迹示例和抽象 insight 分别贡献多少？训练任务与测试任务如何隔离？错误 insight 是否有撤销机制？</z:extra>
    <bib:authors><rdf:Seq>
