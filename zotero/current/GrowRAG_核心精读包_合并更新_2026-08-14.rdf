  <bib:Article rdf:about="#procedural">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Procedural Knowledge at Scale Improves Reasoning</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2604.01348</z:url>
    <dc:identifier>arXiv:2604.01348</dc:identifier>
    <z:extra>发表状态：已列入 COLM 2026 接收论文；截至 2026-08-14 以 arXiv camera-ready 元数据为主。阅读优先级：P0-程序性记忆表示。为什么读：Reasoning Memory 将完整逐步轨迹分解成 3200 万个自包含的子问题与子程序对，并优于文档、完整轨迹和小型模板库检索，是“保存哪部分推理”的强直接基线。精读问题：子问题与子程序怎样自动分解？如何排除答案事实泄漏？大规模覆盖与表示粒度各贡献多少？它的 in-thought query 能否转成 RAG 检索控制笔记？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Di</foaf:givenName><foaf:surname>Wu</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Devendra Singh</foaf:givenName><foaf:surname>Sachan</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Wen-tau</foaf:givenName><foaf:surname>Yih</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Mingda</foaf:givenName><foaf:surname>Chen</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Conference on Language Modeling (COLM 2026)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-程序性记忆</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>已接收-COLM</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#ragtraces">
    <z:itemType>preprint</z:itemType>
    <dc:title>RAG over Thinking Traces Can Improve Reasoning Tasks</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2605.03344</z:url>
    <dc:identifier>arXiv:2605.03344</dc:identifier>
    <z:extra>发表状态：arXiv 预印本；截至 2026-08-14 未核实到正式同行评审接收版本。阅读优先级：P0-最危险表示消融近邻。为什么读：它在同一批 thinking traces 上受控比较完整轨迹、切块轨迹以及结构化步骤、核心语义、错误反思三种 T3 变换，已经直接研究“CoT 哪部分值得保存”。精读问题：不同表示是否严格来自同一源轨迹？token 与候选数量是否匹配？为何最优表示随模型和任务改变？如何把其数学代码结论迁移到知识型 RAG，而不把结果过度泛化？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Negar</foaf:givenName><foaf:surname>Arabzadeh</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Wenjie</foaf:givenName><foaf:surname>Ma</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Sewon</foaf:givenName><foaf:surname>Min</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Matei</foaf:givenName><foaf:surname>Zaharia</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Journal><dc:title>arXiv preprint arXiv:2605.03344</dc:title></bib:Journal></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-危险近邻</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>预印本-未核实正式接收</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <!-- ==================== 可信复用与事后恢复 ==================== -->

  <bib:Article rdf:about="#selectivenet">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>SelectiveNet: A Deep Neural Network with an Integrated Reject Option</dc:title>
    <dc:date>2019</dc:date>
    <z:url>https://proceedings.mlr.press/v97/geifman19a.html</z:url>
    <dc:identifier>PMLR: v97/geifman19a</dc:identifier>
    <z:extra>发表状态：已同行评审，ICML 2019 正式论文。阅读优先级：P0-拒绝使用理论基础。为什么读：SelectiveNet 将预测与拒绝联合优化，并用 risk-coverage 曲线评价“覆盖更多样本”与“只在可靠样本上行动”的权衡，可直接转译为经验调用或 NO_MEMORY。精读问题：coverage 约束如何实现？selective risk 与普通准确率有何不同？校准阈值是否需要训练数据？本项目无训练时应继承评价协议还是模型结构？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Yonatan</foaf:givenName><foaf:surname>Geifman</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Ran</foaf:givenName><foaf:surname>El-Yaniv</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 36th International Conference on Machine Learning</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>2151–2159</bib:pages>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-选择性预测</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-ICML</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#counterfactualharm">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Counterfactual Harm</dc:title>
    <dc:date>2022</dc:date>
    <z:url>https://proceedings.neurips.cc/paper_files/paper/2022/hash/ebcf1bff7b2fe6dcc3fbe666faaa50f1-Abstract-Conference.html</z:url>
    <dc:identifier>DOI: 10.52202/068431-2634</dc:identifier>
    <z:extra>发表状态：已同行评审，NeurIPS 2022 Main 正式论文。阅读优先级：P1-反事实伤害概念基础。为什么读：它用因果模型定义相对某个默认动作的伤害，帮助把“使用记忆后答错”精确定义为相对 DIRECT 基线本可答对却因经验介入而失败，而不是简单统计总错误。精读问题：默认动作如何选择？个体反事实为何通常不可观测？哪些假设支持估计或上界？在 GrowRAG 中 paired replay、oracle 和在线部署分别能观测什么？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Jonathan G.</foaf:givenName><foaf:surname>Richens</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Rory</foaf:givenName><foaf:surname>Beard</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Daniel H.</foaf:givenName><foaf:surname>Thompson</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Advances in Neural Information Processing Systems 35 (NeurIPS 2022)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P1-反事实伤害</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-NeurIPS</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#merit">
    <z:itemType>preprint</z:itemType>
    <dc:title>Causal Episodic Memory for Feedback-Driven Agent Repair</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2608.05906</z:url>
    <dc:identifier>arXiv:2608.05906</dc:identifier>
    <z:extra>发表状态：arXiv 预印本，2026-08-06 首次公开；截至 2026-08-14 未发现正式同行评审接收版本。阅读优先级：P0-刚出现的直接撞车预警。为什么读：MERIT 在 Text-to-SQL 修复中保存 oracle 验证的成功纠正和失败方向，用粗粒度故障类型条件化混合检索，再把历史修复迁移到后续查询；这与 typed repair、双极性经验和跨题修复高度接近。精读问题：oracle 反馈提供了多少额外监督？为什么 typed retrieval 未稳定优于 untyped dynamic retrieval？schema-local 经验为何最可靠？Spider 与 BIRD 结果差异说明哪些迁移边界？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Khang Nhat Hoang</foaf:givenName><foaf:surname>Vo</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Tam Minh</foaf:givenName><foaf:surname>Chu</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Anh Trac Duc</foaf:givenName><foaf:surname>Dinh</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Thuyen Vinh Ha</foaf:givenName><foaf:surname>Bui</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Tho</foaf:givenName><foaf:surname>Quan</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Journal><dc:title>arXiv preprint arXiv:2608.05906</dc:title></bib:Journal></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-危险近邻</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>预印本-未核实正式接收</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#rollbackrepair">
    <z:itemType>preprint</z:itemType>
    <dc:title>From Faulty Memories to Corrected Actions: Dependency-Guided Rollback Repair for Memory-Augmented Agents</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2608.10502</z:url>
    <dc:identifier>arXiv:2608.10502</dc:identifier>
    <z:extra>发表状态：arXiv 预印本，2026-08-11 首次公开；截至 2026-08-14 未发现正式同行评审接收版本。阅读优先级：P0-可信闭环与回滚最新近邻。为什么读：它研究记忆错误已经传播到后续行动和派生记忆后的恢复，构造 typed memory-to-action dependency graph，只失活缺乏独立可信支持的状态并选择性重放受影响计算；这比简单降级或删除经验更完整。精读问题：依赖边怎样从运行时 provenance 得到？错误根因由谁诊断？如何证明保留了无害记忆？回滚、重放和当前回答修复的成本分别是多少？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Caili</foaf:givenName><foaf:surname>Yu</foaf:surname></foaf:Person></rdf:li>
