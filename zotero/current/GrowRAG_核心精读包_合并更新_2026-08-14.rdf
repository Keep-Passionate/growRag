  <!-- ==================== 同行评审优先 ==================== -->

  <bib:Article rdf:about="#rag2020">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks</dc:title>
    <dc:date>2020</dc:date>
    <z:url>https://proceedings.neurips.cc/paper/2020/hash/6b493230205f780e1bc26945df7481e5-Abstract.html</z:url>
    <z:extra>发表状态：已同行评审，NeurIPS 2020 正式论文。阅读优先级：P0-基础。引用快照：Semantic Scholar 16,983，重要引用 1,544（2026-08-13）。为什么读：理解 RAG 的参数记忆、非参数记忆、检索器和生成器最初如何分工；避免把“外部记忆”与“跨题经验记忆”混为一谈。精读问题：它保存什么、检索什么、训练哪些参数、评价的到底是检索还是生成？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Patrick</foaf:givenName><foaf:surname>Lewis</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Ethan</foaf:givenName><foaf:surname>Perez</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Aleksandra</foaf:givenName><foaf:surname>Piktus</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Fabio</foaf:givenName><foaf:surname>Petroni</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Vladimir</foaf:givenName><foaf:surname>Karpukhin</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Naman</foaf:givenName><foaf:surname>Goyal</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Heinrich</foaf:givenName><foaf:surname>Küttler</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Mike</foaf:givenName><foaf:surname>Lewis</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Wen-tau</foaf:givenName><foaf:surname>Yih</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Tim</foaf:givenName><foaf:surname>Rocktäschel</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Sebastian</foaf:givenName><foaf:surname>Riedel</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Douwe</foaf:givenName><foaf:surname>Kiela</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Advances in Neural Information Processing Systems 33 (NeurIPS 2020)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-基础</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-顶会</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#selfrag">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Self-RAG: Learning to Retrieve, Generate, and Critique through Self-Reflection</dc:title>
    <dc:date>2024</dc:date>
    <z:url>https://openreview.net/forum?id=hSyW5go0v8</z:url>
    <dc:identifier>arXiv:2310.11511</dc:identifier>
    <z:extra>发表状态：已同行评审，ICLR 2024；官方项目标注 Oral、top 1%。阅读优先级：P0-控制基础。引用快照：Semantic Scholar 2,363，重要引用 223（2026-08-13）。为什么读：理解“模型何时检索、何时批评证据”的训练型路线，也能看清它和我们的跨题经验复用不是同一对象。精读问题：reflection token 的监督从哪里来？控制是单题内还是跨题？训练成本和推理成本如何计算？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Akari</foaf:givenName><foaf:surname>Asai</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Zeqiu</foaf:givenName><foaf:surname>Wu</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Yizhong</foaf:givenName><foaf:surname>Wang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Avirup</foaf:givenName><foaf:surname>Sil</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Hannaneh</foaf:givenName><foaf:surname>Hajishirzi</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>International Conference on Learning Representations (ICLR 2024)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-控制基础</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-顶会-Oral</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#queryrewrite">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Query Rewriting in Retrieval-Augmented Large Language Models</dc:title>
    <dc:date>2023</dc:date>
    <z:url>https://aclanthology.org/2023.emnlp-main.322/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2023.emnlp-main.322</dc:identifier>
    <z:extra>发表状态：已同行评审，EMNLP 2023 Main。阅读优先级：P0-方法基础。引用快照：Semantic Scholar 159；OpenAlex 235（2026-08-13；不同库勿混比）。为什么读：这是理解“prompt 只是产生改写的机制，真正进入检索器的是新 query”的直接基础。精读问题：改写目标由什么训练或反馈？怎样隔离检索增益与生成器增益？查询预算是否公平？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Xinbei</foaf:givenName><foaf:surname>Ma</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Yeyun</foaf:givenName><foaf:surname>Gong</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Pengcheng</foaf:givenName><foaf:surname>He</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Hai</foaf:givenName><foaf:surname>Zhao</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Nan</foaf:givenName><foaf:surname>Duan</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of EMNLP 2023</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-查询改写</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-顶会主会</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#adaptiverag">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Adaptive-RAG: Learning to Adapt Retrieval-Augmented Large Language Models through Question Complexity</dc:title>
    <dc:date>2024</dc:date>
    <z:url>https://aclanthology.org/2024.naacl-long.389/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2024.naacl-long.389</dc:identifier>
    <z:extra>发表状态：已同行评审，NAACL 2024 Long。阅读优先级：P0-路由基础。引用快照：Semantic Scholar 602；OpenAlex 189（2026-08-13；不同库勿混比）。为什么读：它把问题复杂度映射到不同检索策略，是理解可部署 router 与 oracle 上界差异的重要起点。精读问题：router 看到了哪些特征？标签怎样构造？为什么其动作空间不是历史经验复用？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Soyeong</foaf:givenName><foaf:surname>Jeong</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jinheon</foaf:givenName><foaf:surname>Baek</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Sukmin</foaf:givenName><foaf:surname>Cho</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Sung Ju</foaf:givenName><foaf:surname>Hwang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jong C.</foaf:givenName><foaf:surname>Park</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of NAACL 2024 (Long Papers)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-路由</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-顶会主会</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#rafe">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>RaFe: Ranking Feedback Improves Query Rewriting for RAG</dc:title>
    <dc:date>2024</dc:date>
    <z:url>https://aclanthology.org/2024.findings-emnlp.49/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2024.findings-emnlp.49</dc:identifier>
    <z:extra>发表状态：已同行评审，Findings of EMNLP 2024；不是 EMNLP Main。阅读优先级：P0-反馈基础。引用快照：Semantic Scholar 84；OpenAlex 16（2026-08-13；不同库勿混比）。为什么读：理解怎样用 ranking feedback 评价/优化 query rewrite，直接对应我们“何为成功改写”的检索层标准。精读问题：反馈是 pointwise、pairwise 还是 listwise？是否改善最终答案？与 gold supporting facts 的关系是什么？</z:extra>
