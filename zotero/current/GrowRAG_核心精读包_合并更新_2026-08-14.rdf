      <rdf:li><foaf:Person><foaf:givenName>Ashish</foaf:givenName><foaf:surname>Sabharwal</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 61st Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>10014–10037</bib:pages>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-多跳检索</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-ACL-Main</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#ragcritic">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>RAG-Critic: Leveraging Automated Critic-Guided Agentic Workflow for Retrieval Augmented Generation</dc:title>
    <dc:date>2025</dc:date>
    <z:url>https://aclanthology.org/2025.acl-long.179/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2025.acl-long.179</dc:identifier>
    <z:extra>发表状态：已同行评审，ACL 2025 Main Long 正式论文。阅读优先级：P0-检索后诊断与修复。为什么读：它先建立分层 RAG 错误体系并训练 critic，再根据错误反馈选择执行流程，是可靠修复闭环和失败类型表示的强基线。精读问题：critic 的标签与训练数据怎样构造？错误定位是否依赖答案标签？不同错误类型映射到哪些修复动作？若用轻量规则或无训练判断器替换 critic，收益还剩多少？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Guanting</foaf:givenName><foaf:surname>Dong</foaf:surname></foaf:Person></rdf:li>
