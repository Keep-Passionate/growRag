  <!-- ==================== Contextual Bandit 基础 ==================== -->

  <bib:Article rdf:about="#linucb">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>A Contextual-Bandit Approach to Personalized News Article Recommendation</dc:title>
    <dc:date>2010</dc:date>
    <z:url>https://doi.org/10.1145/1772690.1772758</z:url>
    <dc:identifier>DOI: 10.1145/1772690.1772758</dc:identifier>
    <z:extra>发表状态：已同行评审，WWW 2010 正式论文。阅读优先级：P0-Bandit 入门。引用快照：Semantic Scholar 3,460，重要引用 461（2026-08-13）。为什么读：LinUCB 的经典来源，用最清楚的形式解释“看到 context 后选择一个 arm，只观察该 arm 的 reward，并以不确定性探索”。映射到本项目：context=问题与经验特征；arms=DIRECT/REUSE/FRESH；reward=质量减成本。精读问题：UCB 如何平衡探索利用？离线 replay 的假设是什么？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Lihong</foaf:givenName><foaf:surname>Li</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Wei</foaf:givenName><foaf:surname>Chu</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>John</foaf:givenName><foaf:surname>Langford</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Robert E.</foaf:givenName><foaf:surname>Schapire</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 19th International Conference on World Wide Web (WWW 2010)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P0-Bandit基础</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-经典高引</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#doublyrobust">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Doubly Robust Policy Evaluation and Learning</dc:title>
    <dc:date>2011</dc:date>
    <z:url>https://icml.cc/2011/papers/554_icmlpaper.pdf</z:url>
    <dc:identifier>arXiv:1103.4601</dc:identifier>
    <z:extra>发表状态：已同行评审，ICML 2011 正式论文。阅读优先级：P1-离线 Bandit 评估。引用数：本包未写入未经稳定核验的动态数字；该文是离线策略评价的经典方法论文。为什么读：线上只看到被选动作的 reward，不能直接知道“如果选 REUSE/FRESH 会怎样”；Doubly Robust 结合 reward model 与 propensity 修正来评估新策略。精读问题：DM、IPS、DR 各依赖什么假设？日志必须记录哪些 propensity？</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Miroslav</foaf:givenName><foaf:surname>Dudík</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>John</foaf:givenName><foaf:surname>Langford</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Lihong</foaf:givenName><foaf:surname>Li</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 28th International Conference on Machine Learning (ICML 2011)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag><rdf:li><z:AutomaticTag><rdf:value>GrowRAG-核心精读</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>P1-Off-Policy-Evaluation</rdf:value></z:AutomaticTag></rdf:li><rdf:li><z:AutomaticTag><rdf:value>同行评审-经典</rdf:value></z:AutomaticTag></rdf:li></rdf:Bag></z:tags>
  </bib:Article>

