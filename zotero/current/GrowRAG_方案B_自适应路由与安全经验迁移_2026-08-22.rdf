      <rdf:li><foaf:Person><foaf:givenName>Yi</foaf:givenName><foaf:surname>Cheng</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Chi</foaf:givenName><foaf:surname>Xiu</foaf:surname></foaf:Person></rdf:li>
