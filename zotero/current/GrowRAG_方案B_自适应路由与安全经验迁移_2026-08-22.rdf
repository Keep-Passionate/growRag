      <rdf:li><foaf:Person><foaf:givenName>Haochen</foaf:givenName><foaf:surname>Xue</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Minghao</foaf:givenName><foaf:surname>Guo</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Yongfeng</foaf:givenName><foaf:surname>Zhang</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Journal><dc:title>arXiv</dc:title></bib:Journal></dcterms:isPartOf>
