  <bib:Article rdf:about="#sufficient_context">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Sufficient Context: A New Lens on Retrieval Augmented Generation Systems</dc:title>
    <dc:date>2025</dc:date>
    <z:url>https://openreview.net/forum?id=Jjr2Odj8DJ</z:url>
    <dc:identifier>OpenReview: Jjr2Odj8DJ</dc:identifier>
    <z:extra>发表状态：ICLR 2025 正式同行评审论文。阅读优先级：P0，第 1 篇。它做了什么：区分当前上下文是否足以推出答案与模型是否凭参数知识答对，研究上下文不足时的回答行为。它没做什么：不生成结构化 gap，也不管理历史 query-repair 经验。GrowRAG 必学：最终答案答对不能反推检索证据充分；Judge 必须在 context-only 约束下判断。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Hailey</foaf:givenName><foaf:surname>Joren</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jianyi</foaf:givenName><foaf:surname>Zhang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Chun-Sung</foaf:givenName><foaf:surname>Ferng</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Da-Cheng</foaf:givenName><foaf:surname>Juan</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Ankur</foaf:givenName><foaf:surname>Taly</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Cyrus</foaf:givenName><foaf:surname>Rashtchian</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>The Thirteenth International Conference on Learning Representations</dc:title></bib:Proceedings></dcterms:isPartOf>
  </bib:Article>

  <bib:Article rdf:about="#air">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Unsupervised Alignment-based Iterative Evidence Retrieval for Multi-hop Question Answering</dc:title>
    <dc:date>2020</dc:date>
    <z:url>https://aclanthology.org/2020.acl-main.414/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2020.acl-main.414</dc:identifier>
    <z:extra>发表状态：ACL 2020 Main，正式同行评审论文。阅读优先级：P0。它做了什么：围绕当前 justification 尚未覆盖的 query terms 迭代改写，并在 terms 已覆盖或没有新 query terms 时停止。它没做什么：没有 LLM ExperienceCard、动态可靠性或有害复用。GrowRAG 必学：partial coverage 驱动局部修复和透明 no-new-information 停止已有早期强基线。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Vikas</foaf:givenName><foaf:surname>Yadav</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Steven</foaf:givenName><foaf:surname>Bethard</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Mihai</foaf:givenName><foaf:surname>Surdeanu</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 58th Annual Meeting of the Association for Computational Linguistics</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>4514–4525</bib:pages>
  </bib:Article>

  <bib:Article rdf:about="#subquestion_coverage">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Do RAG Systems Cover What Matters? Evaluating and Optimizing Responses with Sub-Question Coverage</dc:title>
    <dc:date>2025</dc:date>
    <z:url>https://aclanthology.org/2025.naacl-long.301/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2025.naacl-long.301</dc:identifier>
    <z:extra>发表状态：NAACL 2025 Long，正式同行评审论文。阅读优先级：P0。它做了什么：把问题分成 core、background、follow-up 子问题，以 coverage 评价并改进检索和生成。它没做什么：不是迭代 FRESH/REUSE 控制，也不处理历史修复可靠性。GrowRAG 必学：atomic needs 可以有重要性；全部 required needs 与非必要补充项不能同权。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Kaige</foaf:givenName><foaf:surname>Xie</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Philippe</foaf:givenName><foaf:surname>Laban</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Prafulla Kumar</foaf:givenName><foaf:surname>Choubey</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Caiming</foaf:givenName><foaf:surname>Xiong</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Chien-Sheng</foaf:givenName><foaf:surname>Wu</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of NAACL 2025: Human Language Technologies (Volume 1: Long Papers)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>5836–5849</bib:pages>
  </bib:Article>

  <bib:Article rdf:about="#simrag">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Knowing You Don't Know: Learning When to Continue Search in Multi-round RAG through Self-Practicing</dc:title>
    <dc:date>2025</dc:date>
    <z:url>https://doi.org/10.1145/3726302.3730018</z:url>
    <dc:identifier>DOI: 10.1145/3726302.3730018; arXiv: 2505.02811</dc:identifier>
    <z:extra>发表状态：SIGIR 2025 正式同行评审论文。阅读优先级：P0。它做了什么：通过自练习轨迹训练轻量 sufficiency Critic，在每轮 Accept/Reject 候选答案并控制继续搜索。它没做什么：Accept/Reject 容易混入答案正确性，不输出细粒度 gap，也不管理跨题 ExperienceCard。GrowRAG 必学：Judge 可由执行轨迹训练；false rejection 会导致过度检索并把正确答案搜错。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Diji</foaf:givenName><foaf:surname>Yang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Linda</foaf:givenName><foaf:surname>Zeng</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jinmeng</foaf:givenName><foaf:surname>Rao</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Yi</foaf:givenName><foaf:surname>Zhang</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 48th International ACM SIGIR Conference on Research and Development in Information Retrieval</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>1305–1315</bib:pages>
  </bib:Article>

  <bib:Article rdf:about="#halt">
    <z:itemType>journalArticle</z:itemType>
    <dc:title>HALT: Verification-Aware Stopping for Retrieval-Augmented Search Agents</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2608.02009</z:url>
    <dc:identifier>arXiv: 2608.02009</dc:identifier>
    <z:extra>发表状态：截至 2026-08-24 仅确认 arXiv 预印本。阅读优先级：P0，最新重合风险。它做了什么：生成或使用 expected hop claims，将每项与累计证据匹配，全部覆盖后停止；可在无法验证覆盖时拒绝。它没做什么：不复用跨题 query repair，也没有 ExperienceCard reliability/applicability。GrowRAG 必学：need/hop coverage 已不能作为创新；我们必须把它作为历史经验迁移的执行后约束。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Daeyoung</foaf:givenName><foaf:surname>Roh</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Donghee</foaf:givenName><foaf:surname>Han</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Journal><dc:title>arXiv</dc:title></bib:Journal></dcterms:isPartOf>
  </bib:Article>

  <bib:Article rdf:about="#memory_impact">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>How Memory Management Impacts LLM Agents: An Empirical Study of Experience-Following Behavior</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://aclanthology.org/2026.acl-long.27/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2026.acl-long.27</dc:identifier>
    <z:extra>发表状态：ACL 2026 Main Long，正式同行评审论文。阅读优先级：P0。它做了什么：系统分析 memory addition/deletion，发现经验跟随、错误传播和 misaligned experience replay，并用未来任务评价作为记忆质量标签。它没做什么：不是 RAG query repair，也不做 BASE/REUSE 条件伤害。GrowRAG 必学：历史执行即使正确也可能不是好经验；卡片可靠性必须由独立未来题动态验证。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Zidi</foaf:givenName><foaf:surname>Xiong</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Yuping</foaf:givenName><foaf:surname>Lin</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Wenya</foaf:givenName><foaf:surname>Xie</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Pengfei</foaf:givenName><foaf:surname>He</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Zirui</foaf:givenName><foaf:surname>Liu</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jiliang</foaf:givenName><foaf:surname>Tang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Himabindu</foaf:givenName><foaf:surname>Lakkaraju</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Zhen</foaf:givenName><foaf:surname>Xiang</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 64th Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>623–645</bib:pages>
  </bib:Article>

  <bib:Article rdf:about="#tasr">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>TASR: Training-Free Adaptive Stopping for Iterative Retrieval</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2606.13814</z:url>
    <dc:identifier>arXiv: 2606.13814</dc:identifier>
    <z:extra>发表状态：Agent4IR @ KDD 2026 Workshop；不是 KDD 主会，公开版本为 arXiv。阅读优先级：P1。它做了什么：用规范化答案重复和校准 logit margin 的简单规则停止，强调可审计与训练自由。它没做什么：答案稳定不等于证据 needs 已覆盖，也不处理历史经验。GrowRAG 必学：作为低成本 stopping baseline；不要把口头置信度当可靠信号。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Adrian</foaf:givenName><foaf:surname>Kieback</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Uyiosa Philip</foaf:givenName><foaf:surname>Amadasun</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Aman</foaf:givenName><foaf:surname>Chadha</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Aaron</foaf:givenName><foaf:surname>Elkins</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Agent4IR Workshop at KDD 2026</dc:title></bib:Proceedings></dcterms:isPartOf>
  </bib:Article>

  <bib:Article rdf:about="#stoprag">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Stop-RAG: Value-Based Retrieval Control for Iterative RAG</dc:title>
    <dc:date>2025</dc:date>
    <z:url>https://arxiv.org/abs/2510.14337</z:url>
    <dc:identifier>arXiv: 2510.14337</dc:identifier>
    <z:extra>发表状态：NeurIPS 2025 Multi-Turn Interactions in LLMs Workshop；不是 NeurIPS Main。阅读优先级：P1。它做了什么：将停止建成有限时域 MDP，用完整轨迹的 Q(lambda) 目标训练 value controller。它没做什么：不检查结构化 evidence needs，不做经验卡迁移。GrowRAG 必学：后期 learned-controller 对照；v1 不需要先上 RL。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Jaewan</foaf:givenName><foaf:surname>Park</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Solbee</foaf:givenName><foaf:surname>Cho</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jay-Yoon</foaf:givenName><foaf:surname>Lee</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>NeurIPS 2025 Workshop on Multi-Turn Interactions in Large Language Models</dc:title></bib:Proceedings></dcterms:isPartOf>
  </bib:Article>

  <bib:Article rdf:about="#when_stop">
    <z:itemType>journalArticle</z:itemType>
    <dc:title>When Should Multi-Round RAG Stop? Structured Stopping Judgments and Retrieval Reduction in Search-R1</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2608.13237</z:url>
    <dc:identifier>arXiv: 2608.13237</dc:identifier>
    <z:extra>发表状态：截至 2026-08-24 仅确认 arXiv 预印本。阅读优先级：P1 方法学警告。它做了什么：在冻结 Search-R1 上训练 S2G 风格结构 Judge，减少检索但报告 Exact Match 轻微下降。它没做什么：不证明安全停止，也不做历史复用。GrowRAG 必学：节省调用并不等于无损；停止需要同时报告质量、成本和伤害。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Weimeng</foaf:givenName><foaf:surname>Luo</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Journal><dc:title>arXiv</dc:title></bib:Journal></dcterms:isPartOf>
  </bib:Article>

  <bib:Article rdf:about="#efficientrag">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>EfficientRAG: Efficient Retriever for Multi-Hop Question Answering</dc:title>
    <dc:date>2024</dc:date>
    <z:url>https://aclanthology.org/2024.emnlp-main.199/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2024.emnlp-main.199</dc:identifier>
    <z:extra>发表状态：EMNLP 2024 Main，正式同行评审论文。阅读优先级：P1。它做了什么：用轻量 Labeler/Filter 迭代产生 query 并过滤无关信息，避免每轮调用大 LLM。它没做什么：不复用跨题经验，也没有条件伤害门。GrowRAG 必学：FRESH/query filtering 可以轻量化；以后的小模型不必承担答案生成。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Ziyuan</foaf:givenName><foaf:surname>Zhuang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Zhiyang</foaf:givenName><foaf:surname>Zhang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Sitao</foaf:givenName><foaf:surname>Cheng</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Fangkai</foaf:givenName><foaf:surname>Yang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Jia</foaf:givenName><foaf:surname>Liu</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Shujian</foaf:givenName><foaf:surname>Huang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Qingwei</foaf:givenName><foaf:surname>Lin</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Saravan</foaf:givenName><foaf:surname>Rajmohan</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Dongmei</foaf:givenName><foaf:surname>Zhang</foaf:surname></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:givenName>Qi</foaf:givenName><foaf:surname>Zhang</foaf:surname></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Proceedings of the 2024 Conference on Empirical Methods in Natural Language Processing</dc:title></bib:Proceedings></dcterms:isPartOf>
    <bib:pages>3392–3411</bib:pages>
  </bib:Article>

  <bib:Article rdf:about="#iterretgen">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Enhancing Retrieval-Augmented Large Language Models with Iterative Retrieval-Generation Synergy</dc:title>
    <dc:date>2023</dc:date>
    <z:url>https://aclanthology.org/2023.findings-emnlp.620/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2023.findings-emnlp.620</dc:identifier>
    <z:extra>发表状态：Findings of EMNLP 2023，正式同行评审，但不是 EMNLP Main。阅读优先级：P1。它做了什么：用上一轮完整生成结果作为下一轮 retrieval context，在检索与生成间迭代。它没做什么：没有显式 gap/evidence contract，也不复用历史卡。GrowRAG 必学：将生成文本直接当 query context 是强基线，但可能累积错误；我们的 query 必须由 evidence-supported gap 约束。</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:givenName>Zhihong</foaf:givenName><foaf:surname>Shao</foaf:surname></foaf:Person></rdf:li>
