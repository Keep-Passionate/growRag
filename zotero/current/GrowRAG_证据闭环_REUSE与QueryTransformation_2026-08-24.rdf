  <bib:Article rdf:about="#think_rewrite">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Think Then Rewrite: Reasoning Enhanced Query Rewriting for Domain Specific Retrieval</dc:title>
    <dc:date>2026</dc:date>
