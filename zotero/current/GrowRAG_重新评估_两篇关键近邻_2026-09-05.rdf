  <z:Collection rdf:about="#growrag_sep05_boundaries">
    <dc:title>GrowRAG 09-05｜两篇关键近邻与贡献修正</dc:title>
    <dcterms:hasPart rdf:resource="#hu_memory_reuse_2026"/>
    <dcterms:hasPart rdf:resource="#livingrag_2026"/>
