      <rdf:li><foaf:Person><foaf:surname>Zhao</foaf:surname><foaf:givenName>Ruilin</foaf:givenName></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dcterms:isPartOf><bib:Proceedings><dc:title>Findings of the ACL: ACL 2026</dc:title></bib:Proceedings></dcterms:isPartOf>
    <z:tags><rdf:Bag>
      <rdf:li><z:AutomaticTag><rdf:value>RAG2026</rdf:value></z:AutomaticTag></rdf:li>
      <rdf:li><z:AutomaticTag><rdf:value>Structure-aware-RAG</rdf:value></z:AutomaticTag></rdf:li>
      <rdf:li><z:AutomaticTag><rdf:value>★★★★★</rdf:value></z:AutomaticTag></rdf:li>
    </rdf:Bag></z:tags>
  </bib:Article>

  <bib:Article rdf:about="#item_StructureGuidedRAG">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Structure Guided Retrieval-Augmented Generation for Factual Queries</dc:title>
    <dc:date>2026</dc:date><z:url>https://aclanthology.org/2026.acl-long.1873/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2026.acl-long.1873</dc:identifier>
