  <bib:Article rdf:about="#item_OpenScholar">
    <z:itemType>journalArticle</z:itemType>
    <dc:title>Synthesizing scientific literature with retrieval-augmented language models</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://doi.org/10.1038/s41586-025-10072-4</z:url>
    <dc:identifier>DOI: 10.1038/s41586-025-10072-4</dc:identifier>
