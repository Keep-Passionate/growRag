<!-- B. Structure-aware RAG ★★★★★ -->
  <bib:Article rdf:about="#item_DynamicGraphNav">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Dynamic Graph Navigation via Triplet Chains for Structure-Aware Retrieval-Augmented Generation</dc:title>
    <dc:date>2026</dc:date><z:url>https://aclanthology.org/2026.findings-acl.1360/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2026.findings-acl.1360</dc:identifier>
    <z:extra>★★★★★ [Structure-aware-RAG] 用triplet chain (entity,rel,entity) 建模文档关系，解决embedding检索无法理解"A提出B→B改进C"的问题。适合论文知识图谱。PDF: 2026_阅读清单/ACL26_DynamicGraphNav_findings-acl.1360.pdf</z:extra>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:surname>Zhao</foaf:surname><foaf:givenName>Feng</foaf:givenName></foaf:Person></rdf:li>
