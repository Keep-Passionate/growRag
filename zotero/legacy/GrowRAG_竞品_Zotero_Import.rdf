<!-- ============================================================
     6. Memory-R1 — RL学习ADD/UPDATE/DELETE/NOOP，训练成本高
     ============================================================ -->
  <bib:Article rdf:about="#item_Memory_R1">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Memory-R1: Enhancing Large Language Model Agents to Manage and Utilize Memories via Reinforcement Learning</dc:title>
