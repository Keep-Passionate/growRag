<!-- ============================================================
     1. ReflectiveRAG — 单题修复基线 BR
     ============================================================ -->
  <bib:Article rdf:about="#item_ReflectiveRAG">
    <z:itemType>conferencePaper</z:itemType>
    <dc:title>ReflectiveRAG: Rethinking Adaptivity in Retrieval-Augmented Generation</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://aclanthology.org/2026.eacl-industry.27/</z:url>
    <dc:identifier>DOI: 10.18653/v1/2026.eacl-industry.27</dc:identifier>
    <z:extra>[GrowRAG-竞品] 【单题修复基线 BR】1.5B SLM做自反思检索(SRR)+噪声去除(NR)，无需策略训练，+2.7ppEM(HotpotQA)，打败7B RL模型。我们的改进方向：让其修复结果在后续相似查询中被安全摊销。Zotero存储：DUGV4YEY</z:extra>
    <bib:authors>
      <rdf:Seq>
        <rdf:li><foaf:Person><foaf:surname>Verma</foaf:surname><foaf:givenName>Akshay</foaf:givenName></foaf:Person></rdf:li>
        <rdf:li><foaf:Person><foaf:surname>Gupta</foaf:surname><foaf:givenName>Swapnil</foaf:givenName></foaf:Person></rdf:li>
        <rdf:li><foaf:Person><foaf:surname>Pillai</foaf:surname><foaf:givenName>Siddharth</foaf:givenName></foaf:Person></rdf:li>
        <rdf:li><foaf:Person><foaf:surname>Sircar</foaf:surname><foaf:givenName>Prateek</foaf:givenName></foaf:Person></rdf:li>
        <rdf:li><foaf:Person><foaf:surname>Gupta</foaf:surname><foaf:givenName>Deepak</foaf:givenName></foaf:Person></rdf:li>
      </rdf:Seq>
    </bib:authors>
    <dcterms:isPartOf>
      <bib:Proceedings><dc:title>Proceedings of the 2026 Conference of the European Chapter of the ACL: Industry Track (EACL 2026)</dc:title></bib:Proceedings>
    </dcterms:isPartOf>
    <z:tags><rdf:Bag>
      <rdf:li><z:AutomaticTag><rdf:value>GrowRAG-竞品</rdf:value></z:AutomaticTag></rdf:li>
      <rdf:li><z:AutomaticTag><rdf:value>RAG-memory</rdf:value></z:AutomaticTag></rdf:li>
      <rdf:li><z:AutomaticTag><rdf:value>基线BR</rdf:value></z:AutomaticTag></rdf:li>
    </rdf:Bag></z:tags>
  </bib:Article>

<!-- ============================================================
     2. ERM — 最直接竞品，改文档索引我们不改
     ============================================================ -->
  <bib:Article rdf:about="#item_ERM">
    <z:itemType>preprint</z:itemType>
    <dc:title>RAG without Forgetting: Continual Query-Infused Key Memory</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2602.05152</z:url>
    <dc:identifier>arXiv:2602.05152</dc:identifier>
    <z:extra>[GrowRAG-竞品] 【最直接竞品】把成功的query expansion持久化为document key更新(index-side)，training-free，零推理开销，BEIR+BRIGHT 13域+46%BM25/+15%密集。【差异化】ERM改文档key嵌入；我们维护独立经验账本、不碰索引、有abstention。Zotero存储：8H3G28TQ</z:extra>
    <bib:authors>
      <rdf:Seq>
