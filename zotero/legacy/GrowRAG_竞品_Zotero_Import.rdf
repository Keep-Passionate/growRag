        <rdf:li><foaf:Person><foaf:surname>Ye</foaf:surname><foaf:givenName>Guangnan</foaf:givenName></foaf:Person></rdf:li>
        <rdf:li><foaf:Person><foaf:surname>Chai</foaf:surname><foaf:givenName>Hongfeng</foaf:givenName></foaf:Person></rdf:li>
      </rdf:Seq>
