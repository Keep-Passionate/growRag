<!-- ============================================================
     5. MemCon — 在线学习记忆策略(bandit)，本地PDF已下载
     ============================================================ -->
  <bib:Article rdf:about="#item_MemCon">
    <z:itemType>preprint</z:itemType>
    <dc:title>Memory as a Controlled Process: Learned Adaptive Memory Management for LLM Agents</dc:title>
    <dc:date>2026</dc:date>
    <z:url>https://arxiv.org/abs/2607.13591</z:url>
    <dc:identifier>arXiv:2607.13591</dc:identifier>
    <z:extra>[GrowRAG-竞品] 【在线bandit学习记忆控制，已被覆盖】UCLA。MDP建模记忆操作，tabular contextual bandit+UCB学习retrieve/inject/consolidate/forget/noop策略。6基准×3框架×3LLM，+15.2pp，token-5-20%。【差异化】MemCon研究通用agent任务；我们研究RAG-QA检索修复，完全不同场景。PDF已下载至docs/literature_notes/</z:extra>
