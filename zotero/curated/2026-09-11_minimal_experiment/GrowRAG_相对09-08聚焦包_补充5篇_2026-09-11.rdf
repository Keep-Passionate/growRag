    </dc:identifier>
    <dcterms:isPartOf>
      <bib:Journal>
        <dc:title>Proceedings of the 4th International Workshop on Knowledge-Augmented Methods for Natural Language Processing</dc:title>
        <dc:identifier>DOI 10.18653/v1/2025.knowledgenlp-1.29</dc:identifier>
