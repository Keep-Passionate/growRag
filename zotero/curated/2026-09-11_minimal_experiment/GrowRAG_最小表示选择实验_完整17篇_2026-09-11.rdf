        </rdf:li>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Debasis</foaf:givenName>
            <foaf:surname>Ganguly</foaf:surname>
          </foaf:Person>
        </rdf:li>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Craig</foaf:givenName>
            <foaf:surname>MacDonald</foaf:surname>
