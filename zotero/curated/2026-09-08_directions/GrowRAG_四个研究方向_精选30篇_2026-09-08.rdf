    <dc:subject>GrowRAG/研究方向2026-09-08</dc:subject>
    <dc:subject>阅读/选读</dc:subject>
    <dc:subject>方向一｜经验辅助的低成本查询选择</dc:subject>
    <dc:subject>方向四｜证据驱动的有限修复循环</dc:subject>
    <dcterms:isReferencedBy rdf:resource="urn:growrag:reading:20260908:adaptive_rag:guide" />
