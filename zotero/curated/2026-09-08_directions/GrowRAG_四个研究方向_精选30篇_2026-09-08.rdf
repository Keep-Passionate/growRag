      <bib:Journal>
        <dc:title>Proceedings of the 2022 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies</dc:title>
        <dc:identifier>DOI 10.18653/v1/2022.naacl-main.191</dc:identifier>
      </bib:Journal>
