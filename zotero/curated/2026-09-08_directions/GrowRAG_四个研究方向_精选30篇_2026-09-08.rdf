    <dc:title>RAQG-QPP: Query Performance Prediction with Retrieved Query Variants and Retrieval-Augmented Query Generation</dc:title>
    <dc:date>2026</dc:date>
    <bib:authors>
      <rdf:Seq>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Fangzheng</foaf:givenName>
