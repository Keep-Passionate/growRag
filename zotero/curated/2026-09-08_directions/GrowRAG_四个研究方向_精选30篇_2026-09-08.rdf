    <dc:title>S2G-RAG: Structured Sufficiency and Gap Judging for Iterative Retrieval-Augmented QA</dc:title>
    <dc:date>2026</dc:date>
    <bib:authors>
      <rdf:Seq>
        <rdf:li>
          <foaf:Person>
