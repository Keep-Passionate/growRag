        </rdf:li>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Dan</foaf:givenName>
            <foaf:surname>Zhang</foaf:surname>
          </foaf:Person>
        </rdf:li>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Hannah</foaf:givenName>
            <foaf:surname>Kim</foaf:surname>
          </foaf:Person>
        </rdf:li>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Estevam</foaf:givenName>
            <foaf:surname>Hruschka</foaf:surname>
          </foaf:Person>
        </rdf:li>
      </rdf:Seq>
