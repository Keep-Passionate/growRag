    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Am I on the Right Track? What Can Predicted Query Performance Tell Us about the Search Behaviour of Agentic RAG</dc:title>
    <dc:date>2026</dc:date>
    <bib:authors>
      <rdf:Seq>
        <rdf:li>
          <foaf:Person>
            <foaf:givenName>Fangzheng</foaf:givenName>
