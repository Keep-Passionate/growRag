      <rdf:li><foaf:Person><foaf:surname>Khot</foaf:surname><foaf:givenName>Tushar</foaf:givenName></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:surname>Sabharwal</foaf:surname><foaf:givenName>Ashish</foaf:givenName></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
