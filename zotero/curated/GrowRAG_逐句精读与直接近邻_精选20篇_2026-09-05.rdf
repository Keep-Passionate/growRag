    <z:itemType>conferencePaper</z:itemType>
    <dc:title>Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks</dc:title>
    <dc:date>2020</dc:date>
    <bib:authors><rdf:Seq>
