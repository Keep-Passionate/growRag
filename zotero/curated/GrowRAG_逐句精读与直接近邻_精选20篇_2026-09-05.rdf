    <dc:title>SegMem-RAG: Adaptive Memory for Retrieval-Augmented Generation in Open-Ended Knowledge Environments</dc:title>
    <dc:date>2026</dc:date>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person><foaf:surname>Fan</foaf:surname><foaf:givenName>Xuanbo</foaf:givenName></foaf:Person></rdf:li>
