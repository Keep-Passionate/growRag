      <rdf:li><foaf:Person><foaf:surname>Wei</foaf:surname><foaf:givenName>Furu</foaf:givenName></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dc:identifier><dcterms:URI><rdf:value>https://aclanthology.org/2023.emnlp-main.585/</rdf:value></dcterms:URI></dc:identifier>
