      <rdf:li><foaf:Person><foaf:surname>Wang</foaf:surname><foaf:givenName>Wenya</foaf:givenName></foaf:Person></rdf:li>
    </rdf:Seq></bib:authors>
    <dc:identifier><dcterms:URI><rdf:value>https://arxiv.org/abs/2604.27003</rdf:value></dcterms:URI></dc:identifier>
