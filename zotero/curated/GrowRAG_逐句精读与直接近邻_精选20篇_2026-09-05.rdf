      <rdf:li><foaf:Person><foaf:surname>Wu</foaf:surname><foaf:givenName>Zhengkun</foaf:givenName></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:surname>Sun</foaf:surname><foaf:givenName>Yihang</foaf:givenName></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:surname>Li</foaf:surname><foaf:givenName>Bingxuan</foaf:givenName></foaf:Person></rdf:li>
      <rdf:li><foaf:Person><foaf:surname>Li</foaf:surname><foaf:givenName>Dianqi</foaf:givenName></foaf:Person></rdf:li>
